{
  "name": "shopnest-checkout-automation",
  "version": "1.0.0",
  "description": "Automation QA assignment - API and UI regression suite built as the foundation automation framework for ShopNest Checkout 2.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  },
  "engines": {
    "node": ">=18"
  }
}
